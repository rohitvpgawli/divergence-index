{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheDivergenceBucketOnly",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::divergence-index-data-lqpeej"
    },
    {
      "Sid": "ReadWriteObjectsUnderAirbytePrefix",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::divergence-index-data-lqpeej/airbyte/*"
    }
  ]
}
